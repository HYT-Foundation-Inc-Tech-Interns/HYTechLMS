rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function canUseLms() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'Active'
        && (
          request.auth.token.email_verified == true
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'trainer']
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('createdBy', '') == 'admin'
        );
    }

    function isAdmin() {
      return canUseLms()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function classTrainer(classId) {
      return canUseLms()
        && firestore.exists(/databases/(default)/documents/classes/$(classId))
        && (
          firestore.get(/databases/(default)/documents/classes/$(classId)).data.trainerId == request.auth.uid
          || request.auth.uid in firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('coTrainerIds', [])
        );
    }

    function classMember(classId) {
      return canUseLms()
        && (
          firestore.exists(/databases/(default)/documents/classes/$(classId)/members/$(request.auth.uid))
          || (
            firestore.exists(/databases/(default)/documents/enrollments/$(classId + '_' + request.auth.uid))
            && firestore.get(/databases/(default)/documents/enrollments/$(classId + '_' + request.auth.uid)).data.status in ['active', 'ongoing', 'completed']
          )
        );
    }

    // Raster types only: 'image/.*' also admits image/svg+xml, which can carry
    // script that runs if the file is opened directly on the storage origin.
    function isRasterImage() {
      return request.resource.contentType in [
        'image/png', 'image/jpeg', 'image/jpg', 'image/webp', 'image/gif'
      ];
    }

    function isAllowedLmsFile() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'text/plain',
        'text/csv',
        'image/png',
        'image/jpeg',
        'image/webp',
        'image/gif',
        'audio/mpeg',
        'audio/mp4',
        'video/mp4'
      ];
    }

    match /userAvatars/{uid}/{role}/{fileName} {
      allow read: if canUseLms();
      allow write: if canUseLms()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && isRasterImage();
    }
    match /lmsFiles/{classId}/{uid}/{allPaths=**} {
      allow read: if isAdmin()
        || classTrainer(classId)
        || classMember(classId);
      allow write: if canUseLms()
        && request.auth.uid == uid
        && (isAdmin() || classTrainer(classId) || classMember(classId))
        && request.resource.size < 25 * 1024 * 1024
        && isAllowedLmsFile();
    }
    // Public branding assets (site logo). Readable by everyone, including
    // unauthenticated visitors on the landing/sign-in pages; admin-write only.
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && isRasterImage();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
