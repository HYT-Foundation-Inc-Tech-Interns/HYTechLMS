# Copy this file to .env.staging.local for local staging builds.
# If .env.staging.local already exists, add missing keys to it instead of
# copying over it; copying replaces working values with these blanks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public App Check reCAPTCHA v3 site key for the staging registration.
VITE_RECAPTCHA_SITE_KEY=
